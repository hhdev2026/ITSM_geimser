<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ticket cerrado automaticamente</title>
</head>
<body style="margin:0;background:#eef4fb;color:#111827;font-family:Inter,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef4fb;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="620" cellpadding="0" cellspacing="0" style="width:min(620px,100%);background:#ffffff;border:1px solid #d8e4f0;border-radius:12px;overflow:hidden;">
          <tr>
            <td style="background:#111827;color:#ffffff;padding:22px 26px;">
              <strong style="font-size:20px;">Geimser ITSM</strong>
              <div style="color:#9fd8ff;font-size:13px;margin-top:4px;">Cierre automatico</div>
            </td>
          </tr>
          <tr>
            <td style="padding:26px;">
              <h1 style="font-size:22px;line-height:1.3;margin:0 0 12px;color:#0f172a;">Tu ticket fue cerrado automaticamente</h1>
              <p style="font-size:15px;line-height:1.6;margin:0 0 20px;color:#334155;">Cerramos este ticket por falta de respuesta durante 24 horas despues de marcarlo como resuelto.</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 22px;">
                <tr><td style="padding:10px 0;color:#64748b;">Ticket</td><td style="padding:10px 0;text-align:right;font-weight:700;">#<%= h.call(ticket.number) %></td></tr>
                <tr><td style="padding:10px 0;color:#64748b;border-top:1px solid #e2e8f0;">Fecha de cierre</td><td style="padding:10px 0;text-align:right;border-top:1px solid #e2e8f0;"><%= h.call(closed_at) %></td></tr>
                <tr><td style="padding:10px 0;color:#64748b;border-top:1px solid #e2e8f0;">Incidente</td><td style="padding:10px 0;text-align:right;border-top:1px solid #e2e8f0;"><%= h.call(ticket.title) %></td></tr>
              </table>
              <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:14px 16px;">
                <strong style="display:block;margin-bottom:6px;color:#0f172a;">Resumen</strong>
                <span style="color:#475569;line-height:1.55;"><%= h.call(summary) %></span>
              </div>
              <p style="font-size:13px;line-height:1.5;color:#64748b;margin:22px 0 0;">Si el problema continua, genera un nuevo ticket y nuestro equipo retomara la atencion con el contexto actualizado.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
