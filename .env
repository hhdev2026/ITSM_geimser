VERSION=7.0.1-0048
IMAGE_REPO=ghcr.io/zammad/zammad
COMPOSE_PROJECT_NAME=itsm_geimser

TZ=America/Santiago
NGINX_EXPOSE_PORT=8080
NGINX_PORT=8080
NGINX_SERVER_NAME=localhost
ZAMMAD_HTTP_TYPE=http
ZAMMAD_FQDN=localhost:8080

POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=zammad

ELASTICSEARCH_VERSION=9.4.1
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_REINDEX=true

MEMCACHE_VERSION=1.6.42-alpine
REDIS_VERSION=8.6.3-alpine
POSTGRES_VERSION=17.10-alpine
